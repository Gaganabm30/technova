# Server Port
PORT=3000

# Environment mode
NODE_ENV=development

# MongoDB Connection String (leave blank to use persistent built-in document store)
MONGODB_URI=

# JWT Secret for session authentication
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key for AI workflow analytics
GEMINI_API_KEY=

# Client Application URL
CLIENT_URL=http://localhost:3000
